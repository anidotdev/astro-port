---
import Icon from './Icon.astro';
const links = [
  { label: 'GitHub', href: 'https://github.com/animeshhq', icon: 'github' },
  { label: 'LinkedIn', href: '#', icon: 'linkedin' },
  { label: 'X', href: '#', icon: 'x' },
  { label: 'Email', href: 'mailto:hello@animeshhq.dev', icon: 'mail' },
];
---

<section class="section" id="contact">
  <p class="eyebrow">02 — Contact</p>
  <div class="contact-grid">
    {links.map((l) => (
      <a href={l.href} class="contact-link" target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
        <span class="c-left">
          <Icon name={l.icon} />
          {l.label}
        </span>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M9 7h8v8"/></svg>
      </a>
    ))}
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .contact-link {
    background: var(--bg);
    padding: 16px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 14px;
    color: var(--ink);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .contact-link:hover {
    background: var(--bg-raised);
    color: var(--amber);
  }
  .c-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  @media (max-width: 480px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  // no-op, icons rendered via inline component below
</script>
