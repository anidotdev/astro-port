<div aria-hidden="true" data-reading-progress style="position:fixed;left:0;top:0;width:100%;height:2px;background:transparent;z-index:40;pointer-events:none">
  <div data-reading-progress-bar style="width:0;height:100%;background:var(--color-accent)"></div>
</div>
<script>
  const bar = document.querySelector('[data-reading-progress-bar]');
  const update = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    bar?.style.setProperty('width', `${ratio * 100}%`);
  };
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
  update();
</script>
