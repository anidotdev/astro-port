---
import { site } from '../data/site.js';
---
<footer class="footer">
  <div class="site-shell">
    <div class="footer-grid">
      <div>
        <p class="footer-brand">{site.shortName}</p>
        <p class="footer-description">Writing about software, systems, and things worth understanding.</p>
      </div>
      <div class="footer-links">
        <a href="/articles/">Articles</a>
        <a href="/projects/">Projects</a>
        <a href="/about/">About</a>
        <a href={site.rss}>RSS</a>
      </div>
      <div class="footer-links">
        <a href={site.github} rel="me noopener noreferrer">GitHub</a>
        <a href={`mailto:${site.email}`}>Email</a>
        <a href={site.linkedin} rel="me noopener noreferrer">LinkedIn</a>
        <span class="footer-meta">© {new Date().getFullYear()} · Built with Astro.</span>
      </div>
    </div>
  </div>
</footer>
