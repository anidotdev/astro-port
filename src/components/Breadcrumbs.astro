---
const { items = [] } = Astro.props;
---
<nav class="eyebrow" aria-label="Breadcrumb">
  {items.map((item, index) => (
    <span>
      {index > 0 && <span aria-hidden="true"> / </span>}
      {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
    </span>
  ))}
</nav>
