---

---

<section class="hero">
    <div class="banner">
        <img src="/images/banner.png" alt="Animesh portfolio banner" />
    </div>

    <div class="inner profile">
        <div class="avatar" aria-hidden="true">
            <img src="/images/images.jpeg" alt="Animesh" />
        </div>
        <div class="profile-text">
            <p class="status">
                <span class="dot-live"></span> open to freelance work
            </p>
            <h1>Animesh</h1>
            <p class="role">Backend Engineer.</p>
            <p class="meta">2nd-year B.Tech · Delhi, IN</p>
            <div class="hero-socials">
                <a
                    href="https://github.com/animeshhq"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="social-btn"
                    data-cuelume-hover="tick"
                >
                    <i class="ph ph-github-logo"></i>
                    GitHub
                </a>

                <a
                    href="https://www.linkedin.com/in/anidotdev/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="social-btn"
                    data-cuelume-hover="tick"
                >
                    <i class="ph ph-linkedin-logo"></i>
                    LinkedIn
                </a>

                <a
                    href="https://x.com/anidotdev"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="social-btn"
                    data-cuelume-hover="tick"
                >
                    <i class="ph ph-x-logo"></i>
                    Twitter/X
                </a>

                <button
                    id="copy-email"
                    type="button"
                    class="social-btn"
                    data-email="anidotdev@gmail.com"
                    data-cuelume-hover="tick"
                    aria-label="Copy Animesh's email address"
                >
                    <i class="ph ph-envelope-simple"></i>

                    <span id="email-label"> Email </span>
                </button>
            </div>
        </div>
    </div>
</section>

<style>
    .banner {
        height: 220px;
        overflow: hidden;
        background: #0b0d10;
    }

    .banner img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        object-position: center;
    }
    .profile {
        display: flex;
        gap: 22px;
        align-items: flex-start;
        padding-top: 28px;
        padding-bottom: 28px;
    }
    .avatar {
        flex-shrink: 0;
        width: 78px;
        height: 78px;
        border-radius: var(--radius);
        background: var(--bg-raised);
        border: 1px solid var(--line);
        overflow: hidden;
    }

    .avatar img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        object-position: center;
    }
    .status {
        font-family: var(--mono);
        font-size: 12px;
        color: var(--ink-dim);
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 8px;
    }

    .hero-socials {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 16px;
    }

    .social-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;

        padding: 7px 11px;

        border: 1px solid var(--line);
        border-radius: var(--radius);

        background: var(--bg-raised);
        color: var(--ink);

        font-family: var(--sans);
        font-size: 13px;
        font-weight: 500;
        line-height: 1;

        transition:
            border-color 0.15s ease,
            background 0.15s ease,
            transform 0.15s ease;
    }

    .social-btn:hover {
        border-color: var(--ink-faint);
        background: var(--line-soft);
        transform: translateY(-1px);
    }

    h1 {
        font-size: 30px;
        margin-bottom: 4px;
        font-family: "Instagram Sans", sans-serif;
    }
    .role {
        color: var(--ink-dim);
        font-family: "Instagram Sans", sans-serif;
        margin: 0 0 4px;
        font-size: 15px;
    }
    .meta {
        font-family: "Instagram Sans", sans-serif;
        font-size: 12px;
        color: var(--ink-faint);
        margin: 0;
    }
    @media (max-width: 480px) {
        .banner {
            height: 150px;
        }
        .profile {
            gap: 16px;
        }
        .avatar {
            width: 60px;
            height: 60px;
            font-size: 24px;
        }
        h1 {
            font-size: 24px;
        }
    }
</style>

<script>
    import { bind, play } from "cuelume";

    bind();

    /*
     * Browsers block Web Audio until the
     * visitor interacts with the page.
     *
     * The first click or key press unlocks
     * Cuelume for later hover sounds.
     */
    function unlockAudio() {
        play("whisper");

        document.removeEventListener("pointerdown", unlockAudio);

        document.removeEventListener("keydown", unlockAudio);
    }

    document.addEventListener("pointerdown", unlockAudio, { once: true });

    document.addEventListener("keydown", unlockAudio, { once: true });

    const copyButton = document.querySelector<HTMLButtonElement>("#copy-email");

    const emailLabel = document.querySelector<HTMLSpanElement>("#email-label");

    copyButton?.addEventListener("click", async () => {
        const email = copyButton.dataset.email;

        if (!email || !emailLabel) {
            return;
        }

        try {
            await navigator.clipboard.writeText(email);

            emailLabel.textContent = "Copied!";

            play("success");

            window.setTimeout(() => {
                emailLabel.textContent = "Email";
            }, 1500);
        } catch (error) {
            console.error("Could not copy email:", error);

            emailLabel.textContent = "Copy failed";

            window.setTimeout(() => {
                emailLabel.textContent = "Email";
            }, 1500);
        }
    });
</script>
