---

---

<header class="nav">
    <div class="inner nav-inner">
        <a href="/" class="nav-name">Animesh</a>
        <nav class="nav-links">
            <a
                href="#about"
                data-cuelume-hover="tick"
                data-cuelume-press
                data-cuelume-release
            >
                About
            </a>

            <a
                href="#projects"
                data-cuelume-hover="tick"
                data-cuelume-press
                data-cuelume-release
            >
                Projects
            </a>

            <a
                href="#blogs"
                data-cuelume-hover="tick"
                data-cuelume-press
                data-cuelume-release
            >
                Writing
            </a>

            <button
                id="theme-toggle"
                class="theme-toggle"
                type="button"
                aria-label="Switch to light mode"
                data-cuelume-hover="tick"
                data-cuelume-press
                data-cuelume-release
            >
                <i id="icon-moon" class="ph ph-moon" aria-hidden="true"></i>

                <i id="icon-sun" class="ph ph-sun" aria-hidden="true"></i>
            </button>
        </nav>
    </div>
</header>

<style>
    .nav {
        position: sticky;
        top: 0;
        z-index: 20;
        background: color-mix(in srgb, var(--bg) 85%, transparent);
        backdrop-filter: blur(8px);
    }
    .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px var(--gutter);
        max-width: var(--content-w);
    }
    .nav-name {
        font-family: var(--serif);
        font-size: 20px;
        font-style: italic;
    }
    .nav-links {
        display: flex;
        align-items: center;
        gap: 22px;
        font-size: 14px;
        color: var(--ink-dim);
    }
    .nav-links a:hover {
        color: var(--ink);
    }
    .theme-toggle {
        position: relative;

        width: 30px;
        height: 30px;
        padding: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border: 1px solid var(--line);
        border-radius: 50%;

        background: transparent;
        color: var(--ink-dim);

        cursor: pointer;
    }

    .theme-toggle:hover {
        color: var(--amber);
        border-color: var(--amber-dim);
    }

    .theme-toggle i {
        position: absolute;
        inset: 0;

        width: fit-content;
        height: fit-content;
        margin: auto;

        font-size: 17px;
        line-height: 1;
    }
    .theme-toggle:hover {
        color: var(--amber);
        border-color: var(--amber-dim);
    }
    @media (max-width: 480px) {
        .nav-links {
            gap: 14px;
            font-size: 13px;
        }
    }
</style>

<script is:inline>
    (function () {
        const btn = document.getElementById("theme-toggle");
        const moon = document.getElementById("icon-moon");
        const sun = document.getElementById("icon-sun");

        function sync() {
            const theme = document.documentElement.getAttribute("data-theme");

            const isLight = theme === "light";

            moon.style.display = isLight ? "none" : "block";

            sun.style.display = isLight ? "block" : "none";

            btn.setAttribute(
                "aria-label",
                isLight ? "Switch to dark mode" : "Switch to light mode",
            );
        }
        sync();

        btn.addEventListener("click", () => {
            const current = document.documentElement.getAttribute("data-theme");
            const next = current === "light" ? "dark" : "light";
            document.documentElement.setAttribute("data-theme", next);
            localStorage.setItem("theme", next);
            sync();
        });
    })();
</script>
