---
import { blogs } from "../data/blogs";
---

<section class="section" id="blogs">
    <p class="eyebrow">04 — Writing</p>

    <div class="blog-list">
        {
            blogs.map((b) => (
                <a
                    href={b.href}
                    class="blog-row"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <div class="blog-main">
                        <h3 class="blog-title">{b.title}</h3>

                        <div class="blog-meta">
                            <span>{b.date}</span>

                            <span class="dot">·</span>

                            <span>{b.readMins} min read</span>
                        </div>

                        <div class="blog-tags">
                            {b.tags.map((tag) => (
                                <span class="tag">{tag}</span>
                            ))}
                        </div>
                    </div>

                    <i
                        class="ph ph-arrow-up-right blog-arrow"
                        aria-hidden="true"
                    />
                </a>
            ))
        }
    </div>

    <a
        href="https://medium.com/@anidotdev"
        target="_blank"
        rel="noopener noreferrer"
        class="btn view-all"
        data-cuelume-hover="tick"
        data-cuelume-press
        data-cuelume-release
    >
        View all writing

        <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
    </a>
</section>

<style>
    .blog-list {
        display: flex;
        flex-direction: column;
    }

    .blog-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;

        gap: 20px;

        padding: 20px 12px;

        positive: relative;
        border-bottom: none;

        color: var(--ink);

        transition: background-color 150ms ease;
    }

    .blog-list a:last-of-type {
        border-bottom: none;
    }

    .blog-row:hover {
        background: color-mix(in srgb, var(--ink) 4%, transparent);
    }

    .blog-main {
        min-width: 0;
    }

    .blog-title {
        margin: 0 0 8px;

        font-family: var(--sans);
        font-size: 17px;
        font-weight: 600;
        line-height: 1.35;

        color: var(--ink);

        transition: color 150ms ease;
    }

    .blog-row:hover .blog-title {
        color: var(--ink);
    }

    .blog-meta {
        display: flex;
        align-items: center;

        gap: 6px;

        margin-bottom: 10px;

        font-family: var(--mono);
        font-size: 11px;

        color: var(--ink-faint);
    }

    .dot {
        color: var(--ink-faint);
    }

    .blog-tags {
        display: flex;
        flex-wrap: wrap;

        gap: 6px;
    }

    .tag {
        padding: 4px 8px;

        border: 1px solid var(--line);
        border-radius: 5px;

        font-family: var(--mono);
        font-size: 10px;

        color: var(--ink-dim);
    }

    .blog-arrow {
        flex-shrink: 0;

        margin-top: 2px;

        font-size: 15px;

        color: var(--ink-dim);

        transition:
            color 150ms ease,
            transform 150ms ease;
    }

    .blog-row:hover .blog-arrow {
        color: var(--ink);

        transform: translate(2px, -2px);
    }

    .view-all {
        margin-top: 24px;

        transition:
            color 150ms ease,
            border-color 150ms ease,
            background-color 150ms ease,
            transform 150ms ease;
    }

    .view-all:hover {
        color: var(--ink);

        border-color: var(--ink-faint);

        background: color-mix(in srgb, var(--bg-raised) 94%, var(--ink) 6%);

        transform: translateY(-1px);
    }

    .view-all i {
        font-size: 13px;

        transition: transform 150ms ease;
    }

    .view-all:hover i {
        transform: translate(1px, -1px);
    }

    @media (max-width: 480px) {
        .blog-row {
            padding: 18px 8px;
        }

        .blog-title {
            font-size: 16px;
        }

        .blog-meta {
            font-size: 10px;
        }
    }
</style>
