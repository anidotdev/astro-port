---
interface ContributionDay {
    contributionCount: number;
    contributionLevel:
        | "NONE"
        | "FIRST_QUARTILE"
        | "SECOND_QUARTILE"
        | "THIRD_QUARTILE"
        | "FOURTH_QUARTILE";
    date: string;
}

interface ContributionWeek {
    contributionDays: ContributionDay[];
}

interface GitHubResponse {
    data?: {
        user: {
            contributionsCollection: {
                contributionCalendar: {
                    totalContributions: number;
                    weeks: ContributionWeek[];
                };
            };
        } | null;
    };

    errors?: {
        message: string;
    }[];
}

const username = import.meta.env.GITHUB_USERNAME || "animeshhq";

const token = import.meta.env.GITHUB_TOKEN;

const levelMap: Record<ContributionDay["contributionLevel"], number> = {
    NONE: 0,
    FIRST_QUARTILE: 1,
    SECOND_QUARTILE: 2,
    THIRD_QUARTILE: 3,
    FOURTH_QUARTILE: 4,
};

const query = `
  query GetContributionCalendar($username: String!) {
    user(login: $username) {
      contributionsCollection {
        contributionCalendar {
          totalContributions

          weeks {
            contributionDays {
              contributionCount
              contributionLevel
              date
            }
          }
        }
      }
    }
  }
`;

let weeks: ContributionWeek[] = [];
let totalContributions = 0;
let contributionError = "";

if (!token) {
    contributionError =
        "GitHub contribution data is unavailable because GITHUB_TOKEN is missing.";
} else {
    try {
        const response = await fetch("https://api.github.com/graphql", {
            method: "POST",

            headers: {
                Authorization: `Bearer ${token}`,
                "Content-Type": "application/json",
                "User-Agent": "animeshhq-portfolio",
            },

            body: JSON.stringify({
                query,
                variables: {
                    username,
                },
            }),
        });

        if (!response.ok) {
            throw new Error(`GitHub returned HTTP ${response.status}`);
        }

        const result = (await response.json()) as GitHubResponse;

        if (result.errors?.length) {
            throw new Error(
                result.errors.map((error) => error.message).join(", "),
            );
        }

        const calendar =
            result.data?.user?.contributionsCollection.contributionCalendar;

        if (!calendar) {
            throw new Error(`GitHub user "${username}" was not found.`);
        }

        weeks = calendar.weeks;
        totalContributions = calendar.totalContributions;
    } catch (error) {
        contributionError =
            error instanceof Error
                ? error.message
                : "Unable to load GitHub contribution data.";

        console.error("GitHub contribution fetch failed:", error);
    }
}

const contributionDays = weeks.flatMap((week) => week.contributionDays);

const activeDays = contributionDays.filter(
    (day) => day.contributionCount > 0,
).length;

const monthLabels = weeks
    .map((week) => {
        const firstDay = week.contributionDays[0];

        if (!firstDay) {
            return "";
        }

        const date = new Date(`${firstDay.date}T00:00:00`);

        return date.toLocaleDateString("en-US", {
            month: "short",
        });
    })
    .map((month, index, months) => {
        if (index > 0 && month === months[index - 1]) {
            return "";
        }

        return month;
    });
---

<section class="section" id="log">
    <p class="eyebrow">02 — Activities</p>

    <div class="log-panel">
        <div class="log-header">
            <span class="log-line">
                <span class="dot-live"></span>

                SYN → SYN-ACK → ACK &nbsp;|&nbsp; writing, shipping, repeat
            </span>

            {
                !contributionError && (
                    <span class="log-stat">{activeDays} active days</span>
                )
            }
        </div>

        {
            contributionError ? (
                <p class="log-error">
                    GitHub activity is temporarily unavailable.
                </p>
            ) : (
                <>
                    <div class="grid-scroll">
                        <div
                            class="months"
                            style={`grid-template-columns: repeat(${weeks.length}, 1fr)`}
                        >
                            {monthLabels.map((month) => (
                                <span>{month}</span>
                            ))}
                        </div>

                        <div
                            class="grid"
                            style={`grid-template-columns: repeat(${weeks.length}, 1fr)`}
                        >
                            {weeks.map((week) =>
                                week.contributionDays.map((day) => (
                                    <span
                                        class={`cell lvl-${levelMap[day.contributionLevel]}`}
                                        title={`${day.contributionCount} contribution${
                                            day.contributionCount === 1
                                                ? ""
                                                : "s"
                                        } on ${day.date}`}
                                        aria-label={`${day.contributionCount} contributions on ${day.date}`}
                                    />
                                )),
                            )}
                        </div>
                    </div>

                    <div class="log-footer">
                        <span>
                            {totalContributions} contributions in the last year
                        </span>

                        <span class="legend">
                            less
                            <span class="cell lvl-0" />
                            <span class="cell lvl-1" />
                            <span class="cell lvl-2" />
                            <span class="cell lvl-3" />
                            <span class="cell lvl-4" />
                            more
                        </span>
                    </div>
                </>
            )
        }
    </div>
</section>

<style>
    .log-panel {
        border: 1px solid var(--line);
        border-radius: var(--radius);

        background: transparent;

        padding: 18px 20px 16px;
    }

    .log-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;

        margin-bottom: 18px;

        font-family: var(--mono);
        font-size: 12px;

        color: var(--ink);
    }

    .log-line {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .log-stat {
        color: var(--ink);
    }

    .log-error {
        margin: 0;

        font-family: var(--mono);
        font-size: 12px;

        color: var(--ink);
    }

    .grid-scroll {
        overflow-x: auto;
        padding-bottom: 3px;
    }

    .months {
        display: grid;

        min-width: 530px;
        margin-bottom: 6px;

        font-family: var(--mono);
        font-size: 10px;

        color: var(--ink);
    }

    .months span {
        white-space: nowrap;
    }

    .grid {
        display: grid;

        grid-auto-flow: column;
        grid-template-rows: repeat(7, 1fr);

        gap: 3px;

        min-width: 530px;
    }

    .cell {
        width: 100%;

        aspect-ratio: 1;

        border-radius: 2px;

        background: var(--line-soft);
    }

    .lvl-0 {
        background: var(--line-soft);
    }

    .lvl-1 {
        background: color-mix(in srgb, var(--ink) 25%, var(--line-soft));
    }

    .lvl-2 {
        background: color-mix(in srgb, var(--ink) 50%, var(--line-soft));
    }

    .lvl-3 {
        background: color-mix(in srgb, var(--ink) 75%, var(--line-soft));
    }

    .lvl-4 {
        background: var(--ink);
    }

    .log-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;

        margin-top: 14px;

        font-family: var(--mono);
        font-size: 11px;

        color: var(--ink);
    }

    .legend {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .legend .cell {
        width: 10px;
        height: 10px;

        aspect-ratio: unset;
    }

    @media (max-width: 480px) {
        .log-panel {
            padding: 14px;
        }

        .log-footer {
            align-items: flex-start;
            flex-direction: column;
            gap: 10px;
        }
    }
</style>
