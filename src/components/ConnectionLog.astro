---
const username = "animeshhq";
---

<div id="github-root" data-username={username}>
    <div class="log-panel">
        <div class="log-header">
            <span class="log-line">
                <span class="dot-live"></span>
                SYN → SYN-ACK → ACK &nbsp;|&nbsp; writing, shipping, repeat
            </span>
        </div>

        <p class="log-loading">Loading GitHub activity...</p>
    </div>
</div>

<script define:vars={{ username }}>
    const root = document.getElementById("github-root");

    const levelMap = {
        NONE: 0,
        FIRST_QUARTILE: 1,
        SECOND_QUARTILE: 2,
        THIRD_QUARTILE: 3,
        FOURTH_QUARTILE: 4,
    };

    async function loadGitHub() {
        try {
            const response = await fetch(
                `https://github-contributions-api.jogruber.de/v4/${username}`,
            );

            if (!response.ok) {
                throw new Error("Failed to fetch GitHub data");
            }

            const data = await response.json();

            const weeks = data.contributions;
            const totalContributions = data.total?.[0]?.count ?? 0;

            const contributionDays = weeks.flatMap(
                (week) => week.contributionDays,
            );

            const activeDays = contributionDays.filter(
                (day) => day.contributionCount > 0,
            ).length;

            const monthLabels = weeks
                .map((week) => {
                    const firstDay = week.contributionDays[0];

                    if (!firstDay) return "";

                    const date = new Date(firstDay.date + "T00:00:00");

                    return date.toLocaleDateString("en-US", {
                        month: "short",
                    });
                })
                .map((month, index, arr) =>
                    index > 0 && month === arr[index - 1] ? "" : month,
                );

            root.innerHTML = `
        <div class="log-panel">
          <div class="log-header">
            <span class="log-line">
              <span class="dot-live"></span>
              SYN → SYN-ACK → ACK &nbsp;|&nbsp; writing, shipping, repeat
            </span>

            <span class="log-stat">${activeDays} active days</span>
          </div>

          <div class="grid-scroll">
            <div
              class="months"
              style="grid-template-columns: repeat(${weeks.length}, 1fr)"
            >
              ${monthLabels.map((month) => `<span>${month}</span>`).join("")}
            </div>

            <div
              class="grid"
              style="grid-template-columns: repeat(${weeks.length}, 1fr)"
            >
              ${weeks
                  .map((week) =>
                      week.contributionDays
                          .map(
                              (day) => `
                        <span
                          class="cell lvl-${levelMap[day.contributionLevel]}"
                          title="${day.contributionCount} contribution${
                              day.contributionCount === 1 ? "" : "s"
                          } on ${day.date}"
                          aria-label="${day.contributionCount} contributions on ${day.date}"
                        ></span>
                      `,
                          )
                          .join(""),
                  )
                  .join("")}
            </div>
          </div>

          <div class="log-footer">
            <span>${totalContributions} contributions in the last year</span>

            <span class="legend">
              less
              <span class="cell lvl-0"></span>
              <span class="cell lvl-1"></span>
              <span class="cell lvl-2"></span>
              <span class="cell lvl-3"></span>
              <span class="cell lvl-4"></span>
              more
            </span>
          </div>
        </div>
      `;
        } catch (error) {
            console.error(error);

            root.innerHTML = `
        <div class="log-panel">
          <p class="log-error">
            GitHub activity is temporarily unavailable.
          </p>
        </div>
      `;
        }
    }

    loadGitHub();
</script>

<style>
    .log-panel {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1.5rem;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(8px);
    }

    .log-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .log-line {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.9);
    }

    .dot-live {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: #39d353;
        box-shadow: 0 0 0 6px rgba(57, 211, 83, 0.15);
        animation: pulse 1.8s infinite;
    }

    @keyframes pulse {
        0% {
            transform: scale(1);
            opacity: 1;
        }
        70% {
            transform: scale(1.15);
            opacity: 0.65;
        }
        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    .log-stat {
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.65);
    }

    .grid-scroll {
        overflow-x: auto;
        padding-bottom: 0.25rem;
    }

    .months {
        display: grid;
        gap: 3px;
        margin-bottom: 0.35rem;
        font-size: 0.72rem;
        color: rgba(255, 255, 255, 0.55);
        min-width: max-content;
    }

    .months span {
        text-align: left;
    }

    .grid {
        display: grid;
        grid-auto-flow: column;
        grid-template-rows: repeat(7, 12px);
        gap: 3px;
        min-width: max-content;
    }

    .cell {
        width: 12px;
        height: 12px;
        border-radius: 3px;
        background: #161b22;
        transition:
            transform 120ms ease,
            filter 120ms ease;
    }

    .cell:hover {
        transform: scale(1.15);
        filter: brightness(1.1);
    }

    .lvl-0 {
        background: #161b22;
    }
    .lvl-1 {
        background: #0e4429;
    }
    .lvl-2 {
        background: #006d32;
    }
    .lvl-3 {
        background: #26a641;
    }
    .lvl-4 {
        background: #39d353;
    }

    .log-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.65);
    }

    .legend {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .log-loading,
    .log-error {
        margin: 0;
        color: rgba(255, 255, 255, 0.65);
        font-size: 0.95rem;
    }

    .log-error {
        color: #ff8a8a;
    }

    @media (max-width: 640px) {
        .grid {
            grid-template-rows: repeat(7, 10px);
            gap: 2px;
        }

        .cell {
            width: 10px;
            height: 10px;
        }

        .months {
            gap: 2px;
        }
    }
</style>
