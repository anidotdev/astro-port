---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleList from '../../components/ArticleList.astro';
import { getPublishedArticles } from '../../lib/content.js';

const articles = await getPublishedArticles();
const years = [...new Set(articles.map((article) => article.data.date.getFullYear()))];
---
<BaseLayout title="Writing — Animesh" description="Technical writing and things I am learning.">
  <div class="site-shell page-intro compact-intro">
    <p class="eyebrow">Writing</p>
    <h1 class="page-title" style="margin-top:1rem">Articles</h1>
  </div>

  <div class="site-shell archive-page">
    {years.map((year) => {
      const yearArticles = articles.filter((article) => article.data.date.getFullYear() === year);
      return (
        <section class="archive-year-section" aria-labelledby={`year-${year}`}>
          <div class="section-heading">
            <h2 id={`year-${year}`} class="serif year-heading">{year}</h2>
          </div>
          <ArticleList articles={yearArticles} />
        </section>
      );
    })}
  </div>
</BaseLayout>
