---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleList from '../components/ArticleList.astro';
import ProjectList from '../components/ProjectList.astro';
import { getPublishedArticles } from '../lib/content.js';
import { currently } from '../data/site.js';
import { projects } from '../data/projects.js';

const articles = await getPublishedArticles();
const featured = articles.filter((article) => article.data.featured).slice(0, 4);
const latest = articles.slice(0, 5);
const selectedProjects = projects.slice(0, 3);
---
<BaseLayout>
  <div class="site-shell">
    <section class="home-intro" aria-labelledby="intro-title">
      <div class="home-intro-main">
        <h1 id="intro-title" class="editorial-lead">
          I study engineering, build software, and write about the systems and ideas I am still trying to understand.
        </h1>

        <div class="currently-minimal" aria-labelledby="currently-title">
          <p id="currently-title" class="eyebrow">Currently</p>

          <ul class="currently-inline">
            {currently.map((item) => (
              <li>
                <span class="currently-label">{item.label}</span>
                <span class="currently-value">{item.value}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section aria-labelledby="writing-title">
      <div class="section-heading">
        <h2 id="writing-title">Selected writing</h2>
        <a class="section-number" href="/articles/">Archive →</a>
      </div>

      <ArticleList articles={featured.length ? featured : latest} />
    </section>

    <hr class="rule skip-rule" />

    <section aria-labelledby="projects-title">
      <div class="section-heading">
        <h2 id="projects-title">Projects</h2>
        <a class="section-number" href="/projects/">Index →</a>
      </div>

      <ProjectList projects={selectedProjects} />
    </section>

    <hr class="rule skip-rule" />

    <section aria-labelledby="note-title">
      <div class="section-heading">
        <h2 id="note-title">A place to think</h2>
        <a class="section-number" href="/notes/">Notes →</a>
      </div>
    </section>
  </div>
</BaseLayout>
