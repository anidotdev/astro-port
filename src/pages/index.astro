---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleList from '../components/ArticleList.astro';
import ProjectList from '../components/ProjectList.astro';
import { getPublishedArticles } from '../lib/content.js';
import { projects } from '../data/projects.js';

const articles = await getPublishedArticles();
const featured = articles.filter((article) => article.data.featured).slice(0, 4);
const latest = articles.slice(0, 5);
const selectedProjects = projects.slice(0, 3);
---
<BaseLayout>
  <div class="site-shell home-page">
    <section class="home-intro" aria-labelledby="intro-title">
      <h1 id="intro-title" class="editorial-lead">
        I study engineering, build software, and write about the systems and ideas I am still trying to understand.
      </h1>
    </section>

    <section class="home-section" aria-labelledby="writing-title">
      <div class="section-heading">
        <h2 id="writing-title">Writing</h2>
        <a class="section-number" href="/articles/">All →</a>
      </div>

      <ArticleList articles={featured.length ? featured : latest} />
    </section>

    {selectedProjects.length > 0 && (
      <section class="home-section home-projects" aria-labelledby="projects-title">
        <div class="section-heading">
          <h2 id="projects-title">Projects</h2>
          <a class="section-number" href="/projects/">All →</a>
        </div>

        <ProjectList projects={selectedProjects} />
      </section>
    )}
  </div>
</BaseLayout>
