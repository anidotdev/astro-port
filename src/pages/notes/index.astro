---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedNotes } from '../../lib/content.js';

const notes = await getPublishedNotes();

const formatDate = (value) =>
  value.toLocaleDateString('en-US', {
    day: '2-digit',
    month: 'short',
    year: 'numeric'
  });
---

<BaseLayout
  title="Notes — Animesh"
  description="Short observations and working notes from Animesh's engineering notebook."
>
  <div class="site-shell page-intro">
    <p class="eyebrow">Notebook / Short form</p>
    <h1 class="page-title" style="margin-top:1rem">Notes</h1>
    <p
      class="editorial-lead"
      style="margin-top:2rem;font-size:clamp(1.55rem,3.2vw,2.55rem);max-width:29ch"
    >
      Small observations, partial conclusions, and ideas worth keeping around.
    </p>
  </div>

  <section class="site-shell" style="padding-bottom:4rem" aria-labelledby="notes-index-title">
    <div class="section-heading">
      <h2 id="notes-index-title">Notebook entries</h2>
      <span class="section-number">{String(notes.length).padStart(2, '0')}</span>
    </div>

    <div class="notes-list">
      {notes.map((note, index) => (
        <article class="note-row">
          <span class="note-index">{String(index + 1).padStart(2, '0')}</span>

          <div class="note-content">
            <time class="note-date" datetime={note.data.date.toISOString()}>
              {formatDate(note.data.date)}
            </time>

            <a class="note-link" href={`/notes/${note.id}/`}>
              <h3 class="note-title">{note.data.title}</h3>
            </a>
          </div>
        </article>
      ))}

      {!notes.length && (
        <p class="notes-empty">
          No notes yet.
        </p>
      )}
    </div>
  </section>
</BaseLayout>
