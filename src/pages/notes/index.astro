---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedNotes } from '../../lib/content.js';

const notes = await getPublishedNotes();

const formatDate = (value) =>
  value.toLocaleDateString('en-US', {
    day: '2-digit',
    month: 'short',
    year: 'numeric'
  });
---

<BaseLayout title="Notes — Animesh" description="Short notes and things worth keeping around.">
  <div class="site-shell page-intro compact-intro">
    <p class="eyebrow">Notes</p>
    <h1 class="page-title" style="margin-top:1rem">Notes</h1>
  </div>

  <section class="site-shell archive-page" aria-labelledby="notes-index-title">
    <div class="section-heading">
      <h2 id="notes-index-title">Entries</h2>
    </div>

    <div class="notes-list">
      {notes.map((note, index) => (
        <article class="note-row">
          <span class="note-index">{String(index + 1).padStart(2, '0')}</span>

          <div class="note-content">
            <time class="note-date" datetime={note.data.date.toISOString()}>
              {formatDate(note.data.date)}
            </time>

            <a class="note-link" href={`/notes/${note.id}/`}>
              <h3 class="note-title">{note.data.title}</h3>
            </a>
          </div>
        </article>
      ))}

      {!notes.length && <p class="empty-state">Nothing here yet.</p>}
    </div>
  </section>
</BaseLayout>
