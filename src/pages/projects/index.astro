---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectList from '../../components/ProjectList.astro';
import { projects } from '../../data/projects.js';
---
<BaseLayout title="Projects — Animesh" description="Things I have built and experimented with.">
  <div class="site-shell page-intro compact-intro">
    <p class="eyebrow">Projects</p>
    <h1 class="page-title" style="margin-top:1rem">Projects</h1>
  </div>

  <section class="site-shell archive-page" aria-labelledby="projects-list-title">
    <div class="section-heading">
      <h2 id="projects-list-title">Index</h2>
    </div>

    <ProjectList projects={projects} />

    {!projects.length && <p class="empty-state">Nothing here yet.</p>}
  </section>
</BaseLayout>
